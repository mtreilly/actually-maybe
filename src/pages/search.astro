---
import { SITE_LOCALE } from '../i18n/format';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import StructuredData from '../components/StructuredData.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { ui } from '../i18n/ui';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

---

<!doctype html>
<html lang={SITE_LOCALE}>
	<head>
		<BaseHead
			title={`Search | ${SITE_TITLE}`}
			description="Search posts"
		/>
		<StructuredData page={{ kind: 'page', name: 'Search', description: 'Search every post on actuallymaybe.com.', path: '/search/' }} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Search</h1>
			<div class="search-container">
				<input
					type="search"
					id="search-input"
					aria-label={ui.search.label}
					class="search-input"
					placeholder={ui.search.placeholder}
					autocomplete="off"
				/>
			</div>

			<p id="search-status" role="status" aria-atomic="true" class="sr-only"></p>
			<div id="search-results" class="search-results"></div>

			{posts.length === 0 && (
				<p class="no-posts">No posts found.</p>
			)}

			{/* Search itself needs JavaScript. This fallback is the whole index in
			    raw HTML, so the page is still useful to agents and to anyone
			    without scripts. */}
			<section id="all-posts" class="all-posts">
				<h2>Every post</h2>
				<p class="all-posts-note">
					Search needs JavaScript. Without it, here is the full index. You can also
					browse by <a href="/topics/">topic</a>, by <a href="/type/">type</a>, or by
					year in the <a href="/archive/">archive</a>.
				</p>
				<ul class="all-posts-list">
					{posts.map((post) => (
						<li data-search-post data-topics={post.data.topics.join(", ")}>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="all-posts-meta">
								<FormattedDate date={post.data.pubDate} />
								<span aria-hidden="true"> · </span>
								{post.data.type}
							</span>
							{post.data.description && (
								<span class="all-posts-desc">{post.data.description}</span>
							)}
						</li>
					))}
				</ul>
			</section>
		</main>
	<Footer />
	</body>
</html>

<script>
	import Fuse from 'fuse.js';
	import { ui } from '../i18n/ui';
	const status = document.querySelector('#search-status');

	const searchInput = document.querySelector<HTMLInputElement>('#search-input');
	const resultsContainer = document.querySelector<HTMLElement>('#search-results');
	const allPosts = document.querySelector<HTMLElement>('#all-posts');
	const posts = Array.from(document.querySelectorAll<HTMLElement>('[data-search-post]')).map(element => ({
		element,
		title: element.querySelector('a')?.textContent ?? '',
		description: element.querySelector('.all-posts-desc')?.textContent ?? '',
		topics: element.dataset.topics ?? '',
	}));
	const fuse = new Fuse(posts, {
		keys: ['title', 'description', 'topics'],
		threshold: 0.3,
		ignoreLocation: true,
	});
	const RESULT_LIMIT = 20;

	if (searchInput && resultsContainer && allPosts) {
		searchInput.addEventListener('input', () => {
			const query = searchInput.value.trim();
			resultsContainer.replaceChildren();
			allPosts.hidden = query.length > 0;
			if (!query) {
				if (status) status.textContent = ui.search.allPosts;
				return;
			}

			const matches = fuse.search(query, { limit: RESULT_LIMIT });
			if (!matches.length) {
				const message = document.createElement('p');
				message.className = 'no-results';
				message.textContent = ui.search.noResults;
				if (status) status.textContent = ui.search.noResults;
				resultsContainer.append(message);
				return;
			}
			if (status) status.textContent = ui.search.results(matches.length);
			const list = document.createElement('ul');
			list.className = 'all-posts-list';
			for (const { item } of matches) list.append(item.element.cloneNode(true));
			resultsContainer.append(list);
		});
		searchInput.focus();
	}
</script>

<style>
	h1 {
		margin-bottom: 1.5rem;
	}

	.search-container {
		margin-bottom: 2rem;
	}

	.search-input {
		width: 100%;
		padding: 0.75rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		font-size: 1rem;
		background-color: transparent;
		color: rgb(var(--black));
		transition: border-color 0.2s;
	}

	.search-input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
	}

	.search-input::placeholder {
		color: rgb(var(--gray));
	}

	.search-results {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.all-posts {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(128, 128, 128, 0.2);
	}

	.all-posts h2 {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	.all-posts-note {
		color: rgb(var(--gray));
		font-size: 0.9375rem;
		line-height: 1.7;
		margin: 0 0 1.5rem;
		max-width: 60ch;
	}

	:global(.all-posts-list) {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	:global(.all-posts-list li) {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	:global(.all-posts-list a) {
		color: rgb(var(--black));
		text-decoration: none;
		font-weight: 500;
	}

	:global(.all-posts-list a:hover) {
		color: var(--accent);
	}

	:global(.all-posts-meta),
	:global(.all-posts-desc) {
		color: rgb(var(--gray));
		font-size: 0.875rem;
	}

	:global(.no-results) {
		text-align: center;
		color: rgb(var(--gray));
		padding: 2rem 0;
	}

	@media (max-width: 720px) {
		.search-input {
			font-size: 16px;
		}
	}
</style>
