---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostItem from '../components/PostItem.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const LATEST_POSTS_COUNT = 10;
const posts = allPosts.slice(0, LATEST_POSTS_COUNT);
const totalPosts = allPosts.length;
const hasMorePosts = totalPosts > LATEST_POSTS_COUNT;

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<StructuredData page={{ kind: 'home' }} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p class="tagline">Some writing about things.</p>
			<p class="intro">
				I am a software engineer writing about agentic AI tooling, learning systems,
				institutions, and economic history. Most posts here are first-hand notes:
				what I built, what broke, and what I would do differently. Every page is
				also available as clean markdown, either by appending <code>.md</code> to
				the URL or by requesting it with <code>Accept: text/markdown</code>. See
				<a href="/llms.txt">llms.txt</a> for the curated index, or
				<a href="/about/">about</a> for more on what I work on.
			</p>

			<h2 class="section-heading">Latest writing</h2>
			<div class="post-list">
				{posts.map((post) => (
					<PostItem post={post} variant="home" headingLevel={3} />
				))}
			</div>

			{hasMorePosts && (
				<div class="view-all-container">
					<a href="/blog/" class="view-all-link">
						View all {totalPosts} posts →
					</a>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.25rem;
	}

	.tagline {
		color: rgb(var(--gray));
		margin-bottom: 1rem;
		font-size: 1rem;
	}

	.intro {
		color: rgb(var(--gray));
		font-size: 0.9375rem;
		line-height: 1.7;
		margin-bottom: 2rem;
		max-width: 60ch;
	}

	.intro code {
		font-size: 0.875em;
	}

	.section-heading {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0 0 0.5rem;
		color: rgb(var(--black));
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.view-all-container {
		display: flex;
		justify-content: center;
		padding: 2rem 0;
		border-top: 1px solid rgba(var(--gray-light), 0.4);
		margin-top: 1rem;
	}

	.view-all-link {
		color: var(--accent);
		text-decoration: none;
		font-weight: 500;
		padding: 0.5rem 1rem;
		transition: all 0.2s;
		border: 1px solid rgba(37, 99, 235, 0.3);
		border-radius: 4px;
	}

	.view-all-link:hover {
		background-color: rgba(37, 99, 235, 0.05);
		border-color: var(--accent);
	}

	/* Enhanced layout for large screens */
	@media (min-width: 1200px) {
		.tagline {
			font-size: 1.125rem;
			line-height: 1.6;
		}
	}
</style>
