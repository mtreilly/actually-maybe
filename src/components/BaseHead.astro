---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/social-preview.png";
import { SITE_TITLE } from "../consts";
import { AUTHOR_NAME, CONTACT_EMAIL, ORGANISATION_NAME } from "../data/identity";
import { loadKnowledgeGraph } from "../lib/knowledge-graph-loader";
import type { KnowledgeGraph } from "../types/graph";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, imageAlt } = Astro.props;
const socialImageURL = new URL(image.src, Astro.site ?? Astro.url);
const socialImageAlt = imageAlt ?? (image === FallbackImage
	? `Actually Maybe: a blue, hand-drawn approximation mark. Notes and stuff, by ${AUTHOR_NAME}.`
	: title);

let graphStats: KnowledgeGraph["stats"] | null = null;
try {
	const graph = await loadKnowledgeGraph();
	graphStats = graph.stats;
} catch (error) {
	console.warn("Unable to load knowledge graph stats for BaseHead:", error);
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=sketch-1" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-sketch.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-sketch.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_TITLE} />
<meta name="publisher" content={ORGANISATION_NAME} />
<link rel="author" href={new URL('/about/', Astro.site)} />
<link rel="me" href={`mailto:${CONTACT_EMAIL}`} />
<link rel="privacy-policy" href={new URL('/privacy/', Astro.site)} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Theme initialization script - runs before page renders to prevent flash -->
<script is:inline>
	(function() {
		document.documentElement.classList.add('js');
		let savedTheme = null;
		try { savedTheme = localStorage.getItem('theme'); } catch {}
		const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		const theme = (savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : null) || (systemPrefersDark ? 'dark' : 'light');
		document.documentElement.setAttribute('data-theme', theme);
		if (theme === 'dark') {
			document.documentElement.style.backgroundColor = '#111827';
			document.documentElement.style.color = '#f3f4f6';
		}
	})();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/json" title="Knowledge Graph" href="/data/graph.json" />
<link rel="llms-txt" type="text/plain" title="Agent instructions" href="/llms.txt" />
{graphStats && (
	<>
		<meta name="graph:posts" content={String(graphStats.totalPosts)} />
		<meta name="graph:connections" content={String(graphStats.totalEdges)} />
		<meta name="graph:topics" content={String(graphStats.totalTopics)} />
	</>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content={image.width} />
<meta property="og:image:height" content={image.height} />
<meta property="og:image:alt" content={socialImageAlt} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />
<meta property="twitter:image:alt" content={socialImageAlt} />
